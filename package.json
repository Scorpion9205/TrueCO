{
  "name": "vargly-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Vargly — WhatsApp-First Coaching Management SaaS ERP",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:unit": "pnpm --filter @vargly/api run test:unit",
    "lint": "eslint \"apps/api/src/**/*.ts\" \"packages/*/src/**/*.ts\" \"apps/web/**/*.{ts,tsx}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docker:env": "node infra/docker/generate-compose-env.mjs",
    "docker:up": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml up -d --build",
    "docker:down": "docker compose --env-file infra/docker/compose.env -f infra/docker/docker-compose.yml down",
    "prisma:generate": "pnpm --filter @vargly/api run prisma:generate",
    "prisma:migrate": "pnpm --filter @vargly/api run prisma:migrate",
    "prisma:migrate:deploy": "pnpm --filter @vargly/api run prisma:migrate:deploy",
    "test:integration": "pnpm --filter @vargly/api run test:integration",
    "prisma:studio": "pnpm --filter @vargly/api run prisma:studio"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.1"
  },
  "packageManager": "pnpm@11.21.0"
}
