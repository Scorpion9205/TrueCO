# Web app settings. Copy to .env.local for local overrides; the defaults work with `pnpm run docker:up`.

# Public URL of the TrueCO API, used by the browser (and the server when API_INTERNAL_URL is unset)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Public URL of this site, for the sitemap and link previews
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: how this web server reaches the API over a private network (e.g. http://api:4000/api/v1),
# for sign-in, token refresh and pricing. Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=

# Sign-in goes through this server, which passes the visitor's IP to the API in X-Forwarded-For so
# login rate limits and lockouts apply per visitor. The API only believes that header from proxies
# it trusts: set the API's TRUST_PROXY to cover this server (e.g. "loopback, uniquelocal" on a
# private network, or the number of proxy hops in front of the API). Without it, all visitors share
# this server's IP for rate limiting.
