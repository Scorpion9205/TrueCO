# ==============================================================================
# TrueCO Backend Environment Configuration
# ==============================================================================

# Server Runtime
PORT=4000
NODE_ENV=development
LOG_LEVEL=debug
# Run queue workers inside the API too. Defaults to true only when NODE_ENV=development (single
# `pnpm dev`); in staging/production run the worker process separately (`pnpm start:worker`).
# RUN_WORKERS_IN_API=false
CORS_ORIGIN=http://localhost:3000
# Proxy hops in front of the API (1 behind a single ingress/load balancer). Leave false when exposed directly;
# otherwise clients can spoof X-Forwarded-For to evade rate limits and login lockout.
TRUST_PROXY=false
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL Database
# Tenant isolation relies on row-level security, which PostgreSQL skips for superusers. The API
# must connect as the ordinary application role (infra/docker/postgres/create-app-role.sql);
# production refuses to start otherwise. Run migrations separately with the schema owner:
#   DATABASE_URL=<owner url> pnpm prisma:migrate:deploy
# The local docker-compose user below is a superuser, so RLS is not enforced with it (a warning is logged).
DATABASE_URL=postgresql://trueco_user:trueco_password@localhost:5433/trueco_db?schema=public

# Integration tests (optional locally; always run in CI): owner for fixtures, app role for the API under test
# TEST_DATABASE_OWNER_URL=postgresql://<owner>:<password>@localhost:5432/trueco_test
# TEST_DATABASE_URL=postgresql://trueco_app:<password>@localhost:5432/trueco_test

# Redis (Session cache, BullMQ queues, sliding-window rate limiters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security & Authentication (Argon2id + RS256 JWT)
JWT_ACCESS_SECRET=trueco_dev_access_super_secret_key_change_in_production_32char
JWT_REFRESH_SECRET=trueco_dev_refresh_super_secret_key_change_in_production_32char
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# RS256 PEM keys (newlines escaped as \n). REQUIRED in production; the API refuses to start without them.
# In development they may be left empty: a local keypair is generated into .keys/ (git-ignored).
# Generate: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt.key && openssl rsa -in jwt.key -pubout -out jwt.pub
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
DATABASE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# ==============================================================================
# 1. Meta WhatsApp Cloud API
# ==============================================================================
# Obtain from Meta Developers Portal (https://developers.facebook.com)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=trueco_webhook_secret_token
WHATSAPP_API_VERSION=v19.0

# ==============================================================================
# 2. Email / SMTP Configuration
# ==============================================================================
# Use Gmail App Password, AWS SES SMTP, SendGrid, or Mailtrap
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM="TrueCO Alerts <notifications@trueco.in>"

# ==============================================================================
# 3. AI Providers (OpenAI / Claude / Google Gemini)
# ==============================================================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# ==============================================================================
# 4. Object Storage (S3 / Cloudflare R2 / MinIO)
# ==============================================================================
# For local MinIO or AWS S3
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=trueco-attachments
S3_PUBLIC_URL_PREFIX=

# ==============================================================================
# 5. Payment Gateway (Razorpay / UPI)
# ==============================================================================
# Obtain from Razorpay Dashboard (https://dashboard.razorpay.com)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price of one AI credit top-up, in paise (100 = Rs 1 per credit). Plan prices come from the plans table.
AI_CREDIT_PRICE_PAISE=100
